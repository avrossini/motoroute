{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    { "source": "/api/push/dispatch", "destination": "/api/push-dispatch.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/|manifest.json|sw.js|.*\\..*).*)", "destination": "/api/index.js" }
  ]
}
